class Solution {
public:
    string countAndSay(int n) {
        string ans = "1";

        for(int i = 2; i <= n; i++) {
            string next = "";

            for (int j = 0; j < ans.length();) {
                int count = 1;
                while (j + 1 < ans.length() && ans[j] == ans[j + 1]) {
                    count++;
                    j++;
                }
                next += to_string(count);
                next +=ans[j];
                j++;
            }
            ans = next;
        }
        return ans;
    }
};
